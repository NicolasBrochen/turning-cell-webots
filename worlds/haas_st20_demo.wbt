#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "../protos/HaasST20.proto"

WorldInfo {
  info [ "Haas ST-20 PROTO demo with the Haas automation options: auto door + door open switch, auto air jet,"
         "automatic tool presetter (each tool touches the probe), machining, part-off into the parts catcher" ]
  title "Haas ST-20 demo"
  basicTimeStep 16
}
DEF VIEW Viewpoint {
  orientation -0.14395 0.04244 0.98867 2.5743
  position 4.2 -3.0 2.8
  near 0.05
}
TexturedBackground { texture "factory" skybox FALSE skyColor [ 0.2 0.21 0.23 ] luminosity 0.9 }
DirectionalLight { direction -0.3 -0.45 -1 intensity 1.7 castShadows TRUE }
DirectionalLight { direction 0.5 0.4 -1 intensity 0.7 castShadows FALSE }
PointLight { location -0.2 0 1.8 intensity 0.8 attenuation 0 0 1 radius 3 castShadows FALSE }
Floor { size 10 10 tileSize 1 1 }
HaasST20 {
  controller "st20_demo"
  supervisor TRUE
}
# bar stub clamped in the chuck and the piece cut off by the parts-off tool (moved by the demo controller)
DEF BAR_STUB Pose {
  translation -0.4 -0.3775 1.1
  rotation 1 0 0 1.5708
  children [ Shape { appearance PBRAppearance { baseColor 0.4 0.41 0.43 roughness 0.75 metalness 0.6 }
                     geometry Cylinder { radius 0.025 height 0.045 } } ]
}
DEF CUT_PIECE Pose {
  translation -0.4 -0.3325 1.1
  rotation 1 0 0 1.5708
  children [ Shape { appearance PBRAppearance { baseColor 0.8 0.82 0.85 roughness 0.18 metalness 1 }
                     geometry Cylinder { radius 0.025 height 0.045 } } ]
}
